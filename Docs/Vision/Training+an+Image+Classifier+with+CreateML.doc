nter" alt=3D"i4.png" width=3D"468" loading=3D"lazy" src=3D"2f0bb72ceba0d222=
cf294f9ab70055e331824db5c799d3fdf0c4b0e557d538c5" data-image-src=3D"https:/=
/developeracademy.atlassian.net/wiki/download/attachments/1208877328/i4.png=
?version=3D1&amp;modificationDate=3D1750692279033&amp;cacheVersion=3D1&amp;=
api=3Dv2" data-height=3D"385" data-width=3D"782" data-unresolved-comment-co=
